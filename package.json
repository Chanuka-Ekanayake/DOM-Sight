{
  "name": "dom-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension HUD showing live DOM usage vs. a budget (node count, depth, FPS, long tasks, heap).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && vite build -c vite.content.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "smoke": "npm run build && node scripts/smoke-dist.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
